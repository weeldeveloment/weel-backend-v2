# Weel B2B — LiveKit stack'ining sozlamalari. Dokploy'da `livekit` compose
# ilovasining Environment bo'limiga nusxalanadi. Qarang livekit/README.md.
#
#   openssl rand -hex 32   # LIVEKIT_API_SECRET

# Sxemasiz — Traefik shu host bo'yicha yo'naltiradi; DNS'da A yozuvi shart.
PUBLIC_URL=live.weel.uz

# Backend Environment'idagi LIVEKIT_API_KEY / LIVEKIT_API_SECRET AYNAN shu
# juftlik bo'lishi SHART. Kalit — harf-raqam, bo'sh joysiz.
LIVEKIT_API_KEY=weel
LIVEKIT_API_SECRET=CHANGE_ME

# Serverning TASHQI IP manzili — media shu manzilda e'lon qilinadi.
LIVEKIT_NODE_IP=95.182.118.156

# Host'da ochiq bo'lishi kerak: TCP va UDP.
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882

LIVEKIT_IMAGE_VERSION=v1.13
