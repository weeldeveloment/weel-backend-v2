msgstr "Narxlar joriy va keyingi oy uchun taqdim etilishi kerak."

#: apps/property/cottage_serializers.py:938
msgid "This field is required for selected district."
msgstr "Bu maydon tanlangan tuman uchun talab qilinadi."

