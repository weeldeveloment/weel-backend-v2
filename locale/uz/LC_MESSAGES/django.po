msgid "month_from and month_to must be in the same calendar month."
msgstr "month_from va month_to bir xil kalendar oyida bo'lishi kerak."

#: apps/property/cottage_serializers.py:726
msgid "month_to must be greater than or equal to month_from."
msgstr "month_to. month_from dan katta yoki teng boʻlishi kerak."

#: apps/property/cottage_serializers.py:748
msgid "Working days and weekend prices are required in each item or via top-level price_on_working_days / price_on_weekends."
msgstr "Ish kunlari va dam olish kunlari narxlari har bir elementda yoki ish kunidagi yuqori darajadagi narx / dam olish kunlaridagi narxlar orqali talab qilinadi."

#: apps/property/cottage_serializers.py:775
msgid "Duplicate month_from values are not allowed."
msgstr "Takroriy month_from qiymatlariga ruxsat berilmaydi."

#: apps/property/cottage_serializers.py:781
msgid "Exactly 2 monthly prices are required."
msgstr "Aynan 2 oylik narxlar talab qilinadi."

#: apps/property/cottage_serializers.py:798
