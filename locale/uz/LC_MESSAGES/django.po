msgstr "Mulk xizmatlarida yaroqli UUID qiymatlari boʻlishi kerak."

#: apps/property/cottage_serializers.py:648
msgid "month_from, month_to, next_month_from, and next_month_to must all be set together, or omit all four to use default current and next calendar month."
msgstr "month_from, month_to, next_month_from va next_month_to hammasi birgalikda sozlanishi yoki joriy va keyingi kalendar oyini birlamchi ishlatish uchun toʻrttasini qoʻyib yuborish kerak."

#: apps/property/cottage_serializers.py:659
msgid "Do not send `price` together with month_from/month_to/next_month_*; use flat month fields only."
msgstr "Oydan/oydan/keyingi_oyga_* bilan birga “narx”ni yubormang; faqat tekis oy maydonlaridan foydalaning."

#: apps/property/cottage_serializers.py:680
msgid "Must be a list of price objects."
msgstr "Narx ob'ektlari ro'yxati bo'lishi kerak."

#: apps/property/cottage_serializers.py:688
msgid "Each price item must be an object."
msgstr "Har bir narx elementi ob'ekt bo'lishi kerak."

#: apps/property/cottage_serializers.py:697
msgid "month_from and month_to are required for each price item."
msgstr "Har bir narx elementi uchun month_from va month_to koʻrsatkichlari talab qilinadi."

#: apps/property/cottage_serializers.py:709
msgid "Invalid month date format in price items."
msgstr "Narx bandlarida oy sanasi formati yaroqsiz."

