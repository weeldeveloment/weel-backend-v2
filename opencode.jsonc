{
  "$schema": "https://opencode.ai/config.json",

  // Use local Ollama via its OpenAI-compatible endpoint.
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "hf.co/mradermacher/Qwen3-8B-heretic-GGUF:Q4_K_M": {
          "name": "Qwen3-8B-heretic (Q4_K_M)"
        }
      }
    }
  },

  // Default model for this repo.
  "model": "ollama/hf.co/mradermacher/Qwen3-8B-heretic-GGUF:Q4_K_M",
  "small_model": "ollama/hf.co/mradermacher/Qwen3-8B-heretic-GGUF:Q4_K_M"
}
