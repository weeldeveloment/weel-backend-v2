{
 "uid": "weel-logs",
 "title": "Weel — Logs",
 "description": "Loki. trace_id ustiga bosib Tempo'ga o'ting.",
 "tags": [
  "weel",
  "logs"
 ],
 "timezone": "browser",
 "editable": true,
 "graphTooltip": 1,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "timepicker": {
  "refresh_intervals": [
   "10s",
   "30s",
   "1m",
   "5m",
   "15m",
   "1h"
  ]
 },
 "templating": {
  "list": [
   {
    "type": "custom",
    "name": "service",
    "label": "Service",
    "query": "weel-backend,weel-b2b,.*",
    "options": [
     {
      "text": "weel-backend",
      "value": "weel-backend",
      "selected": true
     },
     {
      "text": "weel-b2b",
      "value": "weel-b2b",
      "selected": false
     },
     {
      "text": ".*",
      "value": ".*",
      "selected": false
     }
    ],
    "current": {
     "text": "weel-backend",
     "value": "weel-backend"
    },
    "multi": false,
    "includeAll": false,
    "hide": 0
   },
   {
    "type": "custom",
    "name": "level",
    "label": "Level",
    "query": ".*,error|critical,warning,info,debug",
    "options": [
     {
      "text": ".*",
      "value": ".*",
      "selected": true
     },
     {
      "text": "error|critical",
      "value": "error|critical",
      "selected": false
     },
     {
      "text": "warning",
      "value": "warning",
      "selected": false
     },
     {
      "text": "info",
      "value": "info",
      "selected": false
     },
     {
      "text": "debug",
      "value": "debug",
      "selected": false
     }
    ],
    "current": {
     "text": ".*",
     "value": ".*"
    },
    "multi": false,
    "includeAll": false,
    "hide": 0
   },
   {
    "type": "textbox",
    "name": "search",
    "label": "Matn (regex)",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    },
    "hide": 0
   }
  ]
 },
 "links": [
  {
   "title": "Weel dashboardlari",
   "type": "dashboards",
   "tags": [
    "weel"
   ],
   "asDropdown": true,
   "includeVars": false,
   "keepTime": true,
   "icon": "external link"
  }
 ],
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   },
   {
    "name": "Alertlar (Prometheus)",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "red",
    "expr": "ALERTS{alertstate=\"firing\", severity=~\"critical|warning\"}",
    "titleFormat": "{{alertname}}",
    "textFormat": "{{service}} {{severity}}",
    "step": "1m"
   },
   {
    "name": "Backend deploy (restart)",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "blue",
    "expr": "changes(container_start_time_seconds{name=~\".*weel[-_]?backend.*\"}[2m]) > 0",
    "titleFormat": "backend restart",
    "textFormat": "{{name}}",
    "step": "1m"
   }
  ]
 },
