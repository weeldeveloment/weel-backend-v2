    "definition": "label_values(container_last_seen{name!=\"\"}, name)",
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "sort": 1,
    "regex": "",
    "hide": 0
   }
  ]
 },
 "links": [
  {
   "title": "Weel dashboardlari",
   "type": "dashboards",
   "tags": [
    "weel"
   ],
   "asDropdown": true,
   "includeVars": false,
   "keepTime": true,
   "icon": "external link"
  }
 ],
