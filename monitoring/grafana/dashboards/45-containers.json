  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   },
   {
    "name": "Alertlar (Prometheus)",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "red",
    "expr": "ALERTS{alertstate=\"firing\", severity=~\"critical|warning\"}",
    "titleFormat": "{{alertname}}",
    "textFormat": "{{service}} {{severity}}",
    "step": "1m"
   },
   {
    "name": "Backend deploy (restart)",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "blue",
    "expr": "changes(container_start_time_seconds{name=~\".*weel[-_]?backend.*\"}[2m]) > 0",
    "titleFormat": "backend restart",
    "textFormat": "{{name}}",
    "step": "1m"
   }
  ]
 },
