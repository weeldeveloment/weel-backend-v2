  {
   "type": "timeseries",
   "title": "Loki: qabul (bytes/s), rad etilgan qatorlar",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
