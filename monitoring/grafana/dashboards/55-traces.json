{
 "uid": "weel-traces",
 "title": "Weel — Traces (Tempo)",
 "description": "OpenTelemetry -> Tempo. Span metrics Tempo metrics-generator'dan.",
 "tags": [
  "weel",
  "traces"
 ],
 "timezone": "browser",
 "editable": true,
 "graphTooltip": 1,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "timepicker": {
  "refresh_intervals": [
   "10s",
   "30s",
   "1m",
   "5m",
   "15m",
   "1h"
  ]
 },
 "templating": {
  "list": [
   {
    "type": "query",
    "name": "svc",
    "label": "Service",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(traces_spanmetrics_calls_total, service)",
     "refId": "var"
    },
    "definition": "label_values(traces_spanmetrics_calls_total, service)",
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "sort": 1,
    "regex": "",
    "hide": 0
   }
  ]
 },
 "links": [
  {
   "title": "Weel dashboardlari",
   "type": "dashboards",
   "tags": [
    "weel"
   ],
   "asDropdown": true,
   "includeVars": false,
   "keepTime": true,
   "icon": "external link"
  }
 ],
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   },
   {
    "name": "Alertlar (Prometheus)",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "red",
    "expr": "ALERTS{alertstate=\"firing\", severity=~\"critical|warning\"}",
    "titleFormat": "{{alertname}}",
    "textFormat": "{{service}} {{severity}}",
    "step": "1m"
   },
   {
    "name": "Backend deploy (restart)",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "blue",
    "expr": "changes(container_start_time_seconds{name=~\".*weel[-_]?backend.*\"}[2m]) > 0",
    "titleFormat": "backend restart",
    "textFormat": "{{name}}",
    "step": "1m"
   }
  ]
 },
