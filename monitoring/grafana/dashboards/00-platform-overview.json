  {
   "type": "timeseries",
   "title": "So'rovlar (status klassi bo'yicha)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (class) (label_replace(rate(django_http_responses_total_by_status_total[$__rate_interval]), \"class\", \"${1}xx\", \"status\", \"(\\\\d)\\\\d\\\\d\"))",
     "legendFormat": "{{class}}",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 30,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "normal"
      }
     },
     "unit": "reqps"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "5xx"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "2xx"
      },
