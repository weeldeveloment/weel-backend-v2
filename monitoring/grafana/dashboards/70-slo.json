    "options": [
     {
      "text": "30d",
      "value": "30d",
      "selected": true
     },
     {
      "text": "7d",
      "value": "7d",
      "selected": false
     },
     {
      "text": "24h",
      "value": "24h",
      "selected": false
     },
     {
      "text": "1h",
      "value": "1h",
      "selected": false
     }
