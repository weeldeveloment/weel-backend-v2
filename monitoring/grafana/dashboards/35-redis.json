 "description": "redis-exporter: cache, Celery broker, Channels layer",
 "tags": [
  "weel",
  "infra",
  "redis"
 ],
 "timezone": "browser",
 "editable": true,
 "graphTooltip": 1,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
