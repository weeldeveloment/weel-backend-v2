  {
   "type": "stat",
   "title": "Rad etilgan (401/429) /5m",
   "description": "401 = token noto'g'ri, 429 = throttle, 503 = FRONTEND_LOG_TOKEN o'rnatilmagan",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(django_http_responses_total_by_status_view_method_total{view=~\".*frontend.*|.*FrontendLog.*\", status=~\"401|429|503\"}[5m]))",
     "legendFormat": "__auto",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
