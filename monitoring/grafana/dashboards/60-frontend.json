{
 "uid": "weel-frontend",
 "title": "Weel — Frontend (4 web app)",
 "description": "Brauzer loglari: window.onerror / unhandledrejection / console.error -> backend /api/frontend/ (yoki weel-b2b server.mjs) -> Loki",
 "tags": [
  "weel",
  "frontend"
 ],
 "timezone": "browser",
 "editable": true,
 "graphTooltip": 1,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "timepicker": {
  "refresh_intervals": [
   "10s",
   "30s",
   "1m",
   "5m",
   "15m",
   "1h"
  ]
 },
 "templating": {
  "list": [
   {
    "type": "custom",
    "name": "app",
    "label": "Ilova",
    "query": ".*,weel-admin,dashboard_weel_uz,weel.uz,weel-b2b",
    "options": [
     {
      "text": ".*",
      "value": ".*",
      "selected": true
     },
     {
      "text": "weel-admin",
      "value": "weel-admin",
      "selected": false
     },
     {
      "text": "dashboard_weel_uz",
      "value": "dashboard_weel_uz",
      "selected": false
     },
     {
      "text": "weel.uz",
      "value": "weel.uz",
      "selected": false
     },
     {
      "text": "weel-b2b",
      "value": "weel-b2b",
      "selected": false
     }
    ],
    "current": {
     "text": ".*",
     "value": ".*"
    },
    "multi": false,
    "includeAll": false,
    "hide": 0
   }
  ]
 },
 "links": [
  {
   "title": "Weel dashboardlari",
   "type": "dashboards",
   "tags": [
    "weel"
   ],
   "asDropdown": true,
   "includeVars": false,
   "keepTime": true,
   "icon": "external link"
  }
 ],
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   },
   {
    "name": "Alertlar (Prometheus)",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "red",
    "expr": "ALERTS{alertstate=\"firing\", severity=~\"critical|warning\"}",
    "titleFormat": "{{alertname}}",
    "textFormat": "{{service}} {{severity}}",
    "step": "1m"
   },
   {
    "name": "Backend deploy (restart)",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "blue",
    "expr": "changes(container_start_time_seconds{name=~\".*weel[-_]?backend.*\"}[2m]) > 0",
    "titleFormat": "backend restart",
    "textFormat": "{{name}}",
    "step": "1m"
   }
  ]
 },
