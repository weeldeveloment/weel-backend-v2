    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(count_over_time({service=\"weel-backend\", logger=\"frontend\", app=~\"$app\"} | level=\"error\" [$__range])) + sum(count_over_time({service=\"weel-b2b\", app=~\"$app\"} | level=\"error\" [$__range]))",
     "legendFormat": "__auto",
     "queryType": "instant"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 10
       },
       {
        "color": "red",
        "value": 100
       }
      ]
     },
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "auto",
