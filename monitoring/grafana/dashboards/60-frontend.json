   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(django_http_requests_latency_seconds_by_view_method_count{view=~\".*frontend.*|.*FrontendLog.*\"}[$__rate_interval]))",
     "legendFormat": "__auto",
     "range": true
