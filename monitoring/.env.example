# monitoring/.env  — Dokploy'da bu qiymatlar "Environment" bo'limiga qo'yiladi.
# .env HECH QACHON commit qilinmaydi (monitoring/.gitignore).
# Tasodifiy qiymat: openssl rand -hex 32

# ── Domenlar (DNS A yozuvi Dokploy serverga) ─────────────────────────────
GRAFANA_DOMAIN=grafana.weel.uz
MCP_DOMAIN=mcp.weel.uz

# ── Grafana ─────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE-ME-uzun-tasodifiy
# sqlite3 (default, tayyorgarlik kerak emas) yoki postgres (avval CREATE DATABASE grafana)
GRAFANA_DB_TYPE=sqlite3
GRAFANA_DB_NAME=grafana

# ── Backend scrape ──────────────────────────────────────────────────────
# Dokploy'dagi backend ilovasining nomi (Application -> General -> App Name)
# + port. Shu nom dokploy-network ichida DNS sifatida hal bo'ladi.
BACKEND_TARGET=weel-backend:8000
# Backend ilovasidagi PROMETHEUS_METRICS_TOKEN bilan BIR XIL bo'lishi shart.
PROMETHEUS_METRICS_TOKEN=CHANGE-ME-uzun-tasodifiy
# Alloy loglarda backend/b2b konteynerlarini nomidan taniydi (regex).
BACKEND_CONTAINER_REGEX=.*weel[-_]?(dev|prod|stage)?[-_]?backend.*
B2B_CONTAINER_REGEX=.*weel[-_]?b2b.*

# ── Postgres (backend ishlatadigan instance; postgres-exporter) ─────────
DB_HOST=weel-postgres
DB_PORT=5432
DB_NAME=weel
DB_USER=weel
DB_PASSWORD=CHANGE-ME
DB_SSL_MODE=disable

# ── Redis (backend ishlatadigan instance; redis-exporter + celery-exporter) ─
REDIS_ADDR=redis://weel-redis:6379
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://weel-redis:6379/0
REDIS_EXPORTER_CHECK_KEYS=celery

# ── Prometheus saqlash ──────────────────────────────────────────────────
PROM_RETENTION=30d
PROM_RETENTION_SIZE=8GB

# ── Alertmanager -> Telegram ───────────────────────────────────────────
# @BotFather dan token; chat id — botni guruhga qo'shib
# https://api.telegram.org/bot<TOKEN>/getUpdates dan (guruhda manfiy son).
TELEGRAM_BOT_TOKEN=123456:ABC-CHANGE-ME
TELEGRAM_CHAT_ID=-1001234567890

# ── Alert -> Claude Routine (ixtiyoriy; routine yaratilgach to'ldiriladi) ──
# claude.ai/code/routines -> routine -> "Trigger via API" bo'limidan URL va token.
ROUTINE_FIRE_URL=
ROUTINE_FIRE_TOKEN=
# Agar routine API beta header talab qilsa (masalan
# "anthropic-beta: experimental-cc-routine-2026-04-01") shu yerga to'liq yozing:
ROUTINE_BETA_HEADER=
# "Trigger via API" namunasida matn kaliti "text" bo'lmasa shu yerda o'zgartiring.
ROUTINE_FIRE_BODY_KEY=text
# Routine'ni bundan tez-tez uyg'otmaslik (sekund). Obuna limitini asraydi.
RELAY_MIN_INTERVAL_SECONDS=900

# ── MCP (Claude -> Grafana) ────────────────────────────────────────────
# Grafana: Administration -> Users and access -> Service accounts ->
# "weel-monitor" (Viewer) -> Add token -> glsa_...
GRAFANA_SA_TOKEN=glsa_CHANGE-ME
# URL'dagi sir bo'lak: https://mcp.weel.uz/<MCP_PATH_SECRET>/mcp
MCP_PATH_SECRET=CHANGE-ME-uzun-tasodifiy-hex

# ── ops-agent (Claude Routine -> production amallar) ───────────────────
# Bulutdagi Claude Routine shu token bilan https://MCP_DOMAIN/ops/... ga murojaat qiladi.
OPS_TOKEN=CHANGE-ME-uzun-tasodifiy-hex
# Qaysi konteynerlarga tegish mumkin / hech qachon mumkin emas (regex).
OPS_ALLOW_REGEX=.*
OPS_DENY_REGEX=.*(dokploy|traefik).*
# Soatlik amal limiti (restart/exec-mutating/prune/redeploy). Tugasa 429 — odam aralashsin.
OPS_MAX_ACTIONS_PER_HOUR=12
# Ixtiyoriy: Dokploy API (Settings -> API/CLI -> Generate) — /ops/redeploy uchun.
DOKPLOY_URL=
DOKPLOY_API_KEY=

# ── Tarmoq ─────────────────────────────────────────────────────────────
DOKPLOY_NETWORK=dokploy-network
